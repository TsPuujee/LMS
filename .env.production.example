# Copy to .env.production on the server and fill in the secrets:
#   cp .env.production.example .env.production && make prod-key
# This file is read both by Laravel (env_file) and by Docker Compose (--env-file).
# Do not use ${VAR} references here.

APP_NAME="Номын сан"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://library.example.com

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Ulaanbaatar

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Host port nginx listens on. Put Caddy/Traefik/nginx with TLS in front of it.
APP_PORT=80
IMAGE_TAG=latest

LIBRARY_LOAN_DAYS=14
LIBRARY_RENEW_DAYS=7
LIBRARY_MAX_ACTIVE_LOANS=5

# First librarian account, created once by `make prod-seed`.
ADMIN_NAME="Номын санч"
ADMIN_EMAIL=admin@library.example.com
ADMIN_PASSWORD=change-me
